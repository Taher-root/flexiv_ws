  <version>0.1.0</version>
  <description>RT control launch for a single Rizon 10s arm, wrapping aico2_rt_control.</description>
  <maintainer email="oelinux@todo.todo">oelinux</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>aico2_rt_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
