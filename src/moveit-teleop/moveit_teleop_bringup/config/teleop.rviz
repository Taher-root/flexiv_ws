# Teleop visualisation.
#
# WARNING: RViz REWRITES this file when it saves, and its serialiser drops
# every comment below. If you edit it by hand, do it with RViz closed, and
# expect a later save to flatten it again. Anything that must not be lost
# belongs in teleop.launch.py, not here.
#
# Three deliberate choices survive re-serialisation and are worth restating:
#
#   Fixed Frame: world      The URDF root, which is also MoveIt's planning
#                           frame. Pose targets are stamped in it; viewing
#                           them in another frame makes an offset look like a
#                           retargeting bug.
#
#   TF whitelist            Only tcp_link and teleop_target. With all frames
#                           enabled the arm is a thicket of axes and the gap
#                           between commanded and actual is invisible.
#
#   PlanningScene           The collision geometry move_group actually checks
#                           against. On even when nothing is configured: an
#                           empty scene is positive evidence the checker sees
#                           no obstacle, which is otherwise indistinguishable
#                           from an obstacle that failed to publish -- and
#                           that looks like working collision avoidance right
#                           up until the arm goes through the table.
Panels:
- Class: rviz_common/Displays
  Help Height: 138
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /TF1
    - /TF1/Frames1
    Splitter Ratio: 0.5
  Tree Height: 1365
- Class: moveit_teleop_rviz/ReplayPanel
  Name: Episode Replay
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.10000000149011612
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 0.800000011920929
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
