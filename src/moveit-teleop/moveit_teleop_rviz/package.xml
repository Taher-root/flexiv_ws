<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moveit_teleop_rviz</name>
  <version>0.1.0</version>
  <description>
    RViz panel for reviewing recorded teleop episodes. Holds no playback state
    of its own; it renders episode_player status and sends it commands.
  </description>
  <maintainer email="aadith.j@gmail.com">Aadith</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>moveit_teleop_msgs</depend>
  <depend>qtbase5-dev</depend>

  <exec_depend>moveit_teleop_replay</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
