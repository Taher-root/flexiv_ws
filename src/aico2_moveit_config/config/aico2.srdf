<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description for AICO2 (two Rizon 4 arms on a 2-DoF waist).

  GENERATED from flexiv_amr_description/urdf/AICO2-Rizon4.urdf by
  scripts/generate_srdf.py. The disable_collisions entries below cover
  only the pairs derivable from the kinematic tree:
    Adjacent - parent/child across a joint, always touching
    Welded   - rigidly connected through fixed joints

  NOT covered: pairs that never collide across the reachable workspace,
  or that already collide in the zero pose. Those need geometric
  sampling against the meshes, i.e. a pass with the MoveIt Setup
  Assistant on this URDF. Without them planning still works but is
  slower, and self-collision checks between the two arms and the AMR
  body stay conservative. See docs/moveit_status.md.
-->
<robot name="AICO2">
  <group name="left_arm">
    <chain base_link="Left_link0" tip_link="Left_flange"/>
  </group>
  <group name="right_arm">
    <chain base_link="Right_link0" tip_link="Right_flange"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <!-- home matches mock_idle_joint_positions in left_arm.yaml. joint6=0
       there is a wrist singularity where MoveIt Servo halts, so `ready`
       moves joint6 to +pi/2: plan to `ready` before engaging teleop. -->
  <group_state name="home" group="left_arm">
    <joint name="Left_joint1" value="0.0000"/>
    <joint name="Left_joint2" value="-0.7145"/>
    <joint name="Left_joint3" value="0.0000"/>
    <joint name="Left_joint4" value="1.6559"/>
    <joint name="Left_joint5" value="0.0000"/>
    <joint name="Left_joint6" value="0.0000"/>
    <joint name="Left_joint7" value="0.0000"/>
  </group_state>
  <group_state name="ready" group="left_arm">
    <joint name="Left_joint1" value="0.0000"/>
    <joint name="Left_joint2" value="-0.7145"/>
    <joint name="Left_joint3" value="0.0000"/>
    <joint name="Left_joint4" value="1.6559"/>
    <joint name="Left_joint5" value="0.0000"/>
    <joint name="Left_joint6" value="1.5708"/>
    <joint name="Left_joint7" value="0.0000"/>
  </group_state>
  <group_state name="home" group="right_arm">
    <joint name="Right_joint1" value="0.0000"/>
    <joint name="Right_joint2" value="-0.7145"/>
    <joint name="Right_joint3" value="0.0000"/>
    <joint name="Right_joint4" value="1.6559"/>
    <joint name="Right_joint5" value="0.0000"/>
    <joint name="Right_joint6" value="0.0000"/>
    <joint name="Right_joint7" value="0.0000"/>
  </group_state>
  <group_state name="ready" group="right_arm">
    <joint name="Right_joint1" value="0.0000"/>
    <joint name="Right_joint2" value="-0.7145"/>
    <joint name="Right_joint3" value="0.0000"/>
    <joint name="Right_joint4" value="1.6559"/>
    <joint name="Right_joint5" value="0.0000"/>
    <joint name="Right_joint6" value="1.5708"/>
    <joint name="Right_joint7" value="0.0000"/>
  </group_state>

  <!-- The waist carries both arm bases (Left_Joint0/Right_Joint0 are
       fixed to AGV_Pitch) but nothing in ROS commands it, so it is in no
       planning group: MoveIt sees it as a moving base via /joint_states. -->
  <passive_joint name="AGV_Joint1"/>
  <passive_joint name="AGV_Joint2"/>

  <disable_collisions link1="AGV_Pitch" link2="AGV_Yaw" reason="Adjacent"/>
  <disable_collisions link1="AGV_Pitch" link2="Left_link0" reason="Adjacent"/>
  <disable_collisions link1="AGV_Pitch" link2="Right_link0" reason="Adjacent"/>
  <disable_collisions link1="AGV_Yaw" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="Left_flange" link2="Left_link7" reason="Adjacent"/>
  <disable_collisions link1="Left_link0" link2="Left_link1" reason="Adjacent"/>
  <disable_collisions link1="Left_link0" link2="Right_link0" reason="Welded"/>
  <disable_collisions link1="Left_link1" link2="Left_link2" reason="Adjacent"/>
  <disable_collisions link1="Left_link2" link2="Left_link3" reason="Adjacent"/>
  <disable_collisions link1="Left_link3" link2="Left_link4" reason="Adjacent"/>
  <disable_collisions link1="Left_link4" link2="Left_link5" reason="Adjacent"/>
  <disable_collisions link1="Left_link5" link2="Left_link6" reason="Adjacent"/>
  <disable_collisions link1="Left_link6" link2="Left_link7" reason="Adjacent"/>
  <disable_collisions link1="Right_flange" link2="Right_link7" reason="Adjacent"/>
  <disable_collisions link1="Right_link0" link2="Right_link1" reason="Adjacent"/>
  <disable_collisions link1="Right_link1" link2="Right_link2" reason="Adjacent"/>
  <disable_collisions link1="Right_link2" link2="Right_link3" reason="Adjacent"/>
  <disable_collisions link1="Right_link3" link2="Right_link4" reason="Adjacent"/>
  <disable_collisions link1="Right_link4" link2="Right_link5" reason="Adjacent"/>
  <disable_collisions link1="Right_link5" link2="Right_link6" reason="Adjacent"/>
  <disable_collisions link1="Right_link6" link2="Right_link7" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="camera_color_frame" reason="Welded"/>
  <disable_collisions link1="base_link" link2="camera_depth_frame" reason="Welded"/>
  <disable_collisions link1="base_link" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="camera_top_color_optical_frame" reason="Welded"/>
  <disable_collisions link1="base_link" link2="camera_top_depth_optical_frame" reason="Welded"/>
  <disable_collisions link1="base_link" link2="camera_top_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="imu_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="lidar_avoid_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="lidar_nav_link" reason="Adjacent"/>
  <disable_collisions link1="camera_color_frame" link2="camera_depth_frame" reason="Welded"/>
  <disable_collisions link1="camera_color_frame" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="camera_color_frame" link2="camera_top_color_optical_frame" reason="Welded"/>
  <disable_collisions link1="camera_color_frame" link2="camera_top_depth_optical_frame" reason="Welded"/>
  <disable_collisions link1="camera_color_frame" link2="camera_top_link" reason="Welded"/>
  <disable_collisions link1="camera_color_frame" link2="imu_link" reason="Welded"/>
  <disable_collisions link1="camera_color_frame" link2="lidar_avoid_link" reason="Welded"/>
  <disable_collisions link1="camera_color_frame" link2="lidar_nav_link" reason="Welded"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_top_color_optical_frame" reason="Welded"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_top_depth_optical_frame" reason="Welded"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_top_link" reason="Welded"/>
  <disable_collisions link1="camera_depth_frame" link2="imu_link" reason="Welded"/>
  <disable_collisions link1="camera_depth_frame" link2="lidar_avoid_link" reason="Welded"/>
  <disable_collisions link1="camera_depth_frame" link2="lidar_nav_link" reason="Welded"/>
  <disable_collisions link1="camera_link" link2="camera_top_color_optical_frame" reason="Welded"/>
  <disable_collisions link1="camera_link" link2="camera_top_depth_optical_frame" reason="Welded"/>
  <disable_collisions link1="camera_link" link2="camera_top_link" reason="Welded"/>
  <disable_collisions link1="camera_link" link2="imu_link" reason="Welded"/>
  <disable_collisions link1="camera_link" link2="lidar_avoid_link" reason="Welded"/>
  <disable_collisions link1="camera_link" link2="lidar_nav_link" reason="Welded"/>
  <disable_collisions link1="camera_top_color_optical_frame" link2="camera_top_depth_optical_frame" reason="Welded"/>
  <disable_collisions link1="camera_top_color_optical_frame" link2="camera_top_link" reason="Adjacent"/>
  <disable_collisions link1="camera_top_color_optical_frame" link2="imu_link" reason="Welded"/>
  <disable_collisions link1="camera_top_color_optical_frame" link2="lidar_avoid_link" reason="Welded"/>
  <disable_collisions link1="camera_top_color_optical_frame" link2="lidar_nav_link" reason="Welded"/>
  <disable_collisions link1="camera_top_depth_optical_frame" link2="camera_top_link" reason="Adjacent"/>
  <disable_collisions link1="camera_top_depth_optical_frame" link2="imu_link" reason="Welded"/>
  <disable_collisions link1="camera_top_depth_optical_frame" link2="lidar_avoid_link" reason="Welded"/>
  <disable_collisions link1="camera_top_depth_optical_frame" link2="lidar_nav_link" reason="Welded"/>
  <disable_collisions link1="camera_top_link" link2="imu_link" reason="Welded"/>
  <disable_collisions link1="camera_top_link" link2="lidar_avoid_link" reason="Welded"/>
  <disable_collisions link1="camera_top_link" link2="lidar_nav_link" reason="Welded"/>
  <disable_collisions link1="imu_link" link2="lidar_avoid_link" reason="Welded"/>
  <disable_collisions link1="imu_link" link2="lidar_nav_link" reason="Welded"/>
  <disable_collisions link1="lidar_avoid_link" link2="lidar_nav_link" reason="Welded"/>
</robot>
