<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description for AICO2-Rizon4 (two Rizon 4 arms on a 2-DoF waist).

  GENERATED from flexiv_description xacro (robot_type=AICO2-4E-D1) by
  scripts/generate_srdf.py. The disable_collisions entries below cover
  only the pairs derivable from the kinematic tree, after collapsing
  fixed joints into rigid bodies:
    Welded   - same rigid body, cannot move relative to each other
    Adjacent - rigid bodies joined by one actuated joint

  NOT covered: pairs that never collide across the reachable workspace,
  and the remaining pairs that already collide in some pose. Those need
  geometric sampling against the meshes, i.e. a pass with the MoveIt
  Setup Assistant on this URDF. Without them planning still works but
  is slower and cross-arm checking stays conservative.
  See docs/moveit_status.md.
-->
<robot name="AICO2-Rizon4">
  <group name="left_arm">
    <chain base_link="Left_link0" tip_link="Left_flange"/>
  </group>
  <group name="right_arm">
    <chain base_link="Right_link0" tip_link="Right_flange"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <!-- base_link -> Left_flange runs through AGV_Joint1 and AGV_Joint2,
       so this chain is 9 joints: the two waist axes then the seven arm
       ones. Only the LEFT arm gets a waist group, because the external
       axes are shared and the left driver is the one that owns them
       (control_waist:=true). -->
  <group name="left_arm_waist">
    <chain base_link="base_link" tip_link="Left_flange"/>
  </group>

  <!-- Gripper groups (Flexiv GN01).  Only the control joint; mimic joints
       are driven by it.  Names are lowercase: the xacro prefix is "left_"/
       "right_" and _URDF_RENAMES does not match gripper elements. -->
  <group name="left_gripper">
    <joint name="left_finger_width_joint"/>
  </group>
  <group name="right_gripper">
    <joint name="right_finger_width_joint"/>
  </group>

  <!-- home matches mock_idle_joint_positions in left_arm.yaml. joint6=0
       there is a wrist singularity where MoveIt Servo halts, so `ready`
       moves joint6 to +pi/2: plan to `ready` before engaging teleop. -->
  <group_state name="home" group="left_arm">
    <joint name="Left_joint1" value="0.0000"/>
    <joint name="Left_joint2" value="-0.7145"/>
    <joint name="Left_joint3" value="0.0000"/>
    <joint name="Left_joint4" value="1.6559"/>
    <joint name="Left_joint5" value="0.0000"/>
    <joint name="Left_joint6" value="0.0000"/>
    <joint name="Left_joint7" value="0.0000"/>
  </group_state>
  <group_state name="ready" group="left_arm">
    <joint name="Left_joint1" value="0.0000"/>
    <joint name="Left_joint2" value="-0.7145"/>
    <joint name="Left_joint3" value="0.0000"/>
    <joint name="Left_joint4" value="1.6559"/>
    <joint name="Left_joint5" value="0.0000"/>
    <joint name="Left_joint6" value="1.5708"/>
    <joint name="Left_joint7" value="0.0000"/>
  </group_state>
  <group_state name="home" group="right_arm">
    <joint name="Right_joint1" value="0.0000"/>
    <joint name="Right_joint2" value="-0.7145"/>
    <joint name="Right_joint3" value="0.0000"/>
    <joint name="Right_joint4" value="1.6559"/>
    <joint name="Right_joint5" value="0.0000"/>
    <joint name="Right_joint6" value="0.0000"/>
    <joint name="Right_joint7" value="0.0000"/>
  </group_state>
  <group_state name="ready" group="right_arm">
    <joint name="Right_joint1" value="0.0000"/>
    <joint name="Right_joint2" value="-0.7145"/>
    <joint name="Right_joint3" value="0.0000"/>
    <joint name="Right_joint4" value="1.6559"/>
    <joint name="Right_joint5" value="0.0000"/>
    <joint name="Right_joint6" value="1.5708"/>
    <joint name="Right_joint7" value="0.0000"/>
  </group_state>

  <group_state name="home" group="left_arm_waist">
    <joint name="AGV_Joint1" value="0.0000"/>
    <joint name="AGV_Joint2" value="0.0000"/>
    <joint name="Left_joint1" value="0.0000"/>
    <joint name="Left_joint2" value="-0.7145"/>
    <joint name="Left_joint3" value="0.0000"/>
    <joint name="Left_joint4" value="1.6559"/>
    <joint name="Left_joint5" value="0.0000"/>
    <joint name="Left_joint6" value="0.0000"/>
    <joint name="Left_joint7" value="0.0000"/>
  </group_state>
  <group_state name="ready" group="left_arm_waist">
    <joint name="AGV_Joint1" value="0.0000"/>
    <joint name="AGV_Joint2" value="0.0000"/>
    <joint name="Left_joint1" value="0.0000"/>
    <joint name="Left_joint2" value="-0.7145"/>
    <joint name="Left_joint3" value="0.0000"/>
    <joint name="Left_joint4" value="1.6559"/>
    <joint name="Left_joint5" value="0.0000"/>
    <joint name="Left_joint6" value="1.5708"/>
    <joint name="Left_joint7" value="0.0000"/>
  </group_state>

  <group_state name="open" group="left_gripper">
    <joint name="left_finger_width_joint" value="0.100"/>
  </group_state>
  <group_state name="close" group="left_gripper">
    <joint name="left_finger_width_joint" value="0.0"/>
  </group_state>
  <group_state name="open" group="right_gripper">
    <joint name="right_finger_width_joint" value="0.100"/>
  </group_state>
  <group_state name="close" group="right_gripper">
    <joint name="right_finger_width_joint" value="0.0"/>
  </group_state>

  <end_effector name="left_hand" parent_link="Left_flange" group="left_gripper" parent_group="left_arm"/>
  <end_effector name="right_hand" parent_link="Right_flange" group="right_gripper" parent_group="right_arm"/>

  <!-- AGV_Joint1/2 were <passive_joint> here, which tells MoveIt they
       cannot be commanded. They can now: the left arm driver owns them
       with control_waist:=true and accepts them in a
       follow_joint_trajectory goal, so they belong to left_arm_waist
       and a passive declaration would make MoveIt refuse to plan them.
       With control_waist false the driver silently drops the waist
       columns and only the arm moves. -->

  <disable_collisions link1="AGV_Pitch" link2="AGV_Yaw" reason="Adjacent"/>
  <disable_collisions link1="AGV_Pitch" link2="Left_link0" reason="Welded"/>
  <disable_collisions link1="AGV_Pitch" link2="Left_link1" reason="Adjacent"/>
  <disable_collisions link1="AGV_Pitch" link2="Right_link0" reason="Welded"/>
  <disable_collisions link1="AGV_Pitch" link2="Right_link1" reason="Adjacent"/>
  <disable_collisions link1="AGV_Yaw" link2="Left_link0" reason="Adjacent"/>
  <disable_collisions link1="AGV_Yaw" link2="Right_link0" reason="Adjacent"/>
  <disable_collisions link1="AGV_Yaw" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="Left_flange" link2="Left_link6" reason="Adjacent"/>
  <disable_collisions link1="Left_flange" link2="Left_link7" reason="Welded"/>
  <disable_collisions link1="Left_link0" link2="Left_link1" reason="Adjacent"/>
  <disable_collisions link1="Left_link0" link2="Right_link0" reason="Welded"/>
  <disable_collisions link1="Left_link0" link2="Right_link1" reason="Adjacent"/>
  <disable_collisions link1="Left_link1" link2="Left_link2" reason="Adjacent"/>
  <disable_collisions link1="Left_link1" link2="Right_link0" reason="Adjacent"/>
  <disable_collisions link1="Left_link2" link2="Left_link3" reason="Adjacent"/>
  <disable_collisions link1="Left_link3" link2="Left_link4" reason="Adjacent"/>
  <disable_collisions link1="Left_link4" link2="Left_link5" reason="Adjacent"/>
  <disable_collisions link1="Left_link5" link2="Left_link6" reason="Adjacent"/>
  <disable_collisions link1="Left_link6" link2="Left_link7" reason="Adjacent"/>
  <disable_collisions link1="Right_flange" link2="Right_link6" reason="Adjacent"/>
  <disable_collisions link1="Right_flange" link2="Right_link7" reason="Welded"/>
  <disable_collisions link1="Right_link0" link2="Right_link1" reason="Adjacent"/>
  <disable_collisions link1="Right_link1" link2="Right_link2" reason="Adjacent"/>
  <disable_collisions link1="Right_link2" link2="Right_link3" reason="Adjacent"/>
  <disable_collisions link1="Right_link3" link2="Right_link4" reason="Adjacent"/>
  <disable_collisions link1="Right_link4" link2="Right_link5" reason="Adjacent"/>
  <disable_collisions link1="Right_link5" link2="Right_link6" reason="Adjacent"/>
  <disable_collisions link1="Right_link6" link2="Right_link7" reason="Adjacent"/>

  <!-- Left gripper (GN01) -->
  <disable_collisions link1="Left_flange" link2="left_grav_base_link" reason="Welded"/>
  <disable_collisions link1="Left_link7" link2="left_grav_base_link" reason="Welded"/>
  <disable_collisions link1="Left_link6" link2="left_grav_base_link" reason="Adjacent"/>
  <disable_collisions link1="left_grav_base_link" link2="left_left_outer_bar" reason="Adjacent"/>
  <disable_collisions link1="left_grav_base_link" link2="left_left_inner_bar" reason="Adjacent"/>
  <disable_collisions link1="left_grav_base_link" link2="left_right_outer_bar" reason="Adjacent"/>
  <disable_collisions link1="left_grav_base_link" link2="left_right_inner_bar" reason="Adjacent"/>
  <disable_collisions link1="left_left_outer_bar" link2="left_left_inner_bar" reason="Adjacent"/>
  <disable_collisions link1="left_left_outer_bar" link2="left_left_finger_tip" reason="Adjacent"/>
  <disable_collisions link1="left_left_inner_bar" link2="left_left_finger_tip" reason="Adjacent"/>
  <disable_collisions link1="left_right_outer_bar" link2="left_right_inner_bar" reason="Adjacent"/>
  <disable_collisions link1="left_right_outer_bar" link2="left_right_finger_tip" reason="Adjacent"/>
  <disable_collisions link1="left_right_inner_bar" link2="left_right_finger_tip" reason="Adjacent"/>

  <!-- Right gripper (GN01) -->
  <disable_collisions link1="Right_flange" link2="right_grav_base_link" reason="Welded"/>
  <disable_collisions link1="Right_link7" link2="right_grav_base_link" reason="Welded"/>
  <disable_collisions link1="Right_link6" link2="right_grav_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_grav_base_link" link2="right_left_outer_bar" reason="Adjacent"/>
  <disable_collisions link1="right_grav_base_link" link2="right_left_inner_bar" reason="Adjacent"/>
  <disable_collisions link1="right_grav_base_link" link2="right_right_outer_bar" reason="Adjacent"/>
  <disable_collisions link1="right_grav_base_link" link2="right_right_inner_bar" reason="Adjacent"/>
  <disable_collisions link1="right_left_outer_bar" link2="right_left_inner_bar" reason="Adjacent"/>
  <disable_collisions link1="right_left_outer_bar" link2="right_left_finger_tip" reason="Adjacent"/>
  <disable_collisions link1="right_left_inner_bar" link2="right_left_finger_tip" reason="Adjacent"/>
  <disable_collisions link1="right_right_outer_bar" link2="right_right_inner_bar" reason="Adjacent"/>
  <disable_collisions link1="right_right_outer_bar" link2="right_right_finger_tip" reason="Adjacent"/>
  <disable_collisions link1="right_right_inner_bar" link2="right_right_finger_tip" reason="Adjacent"/>
</robot>
