<?xml version="1.0" encoding="UTF-8"?>
<!--
  FastRTPS profile for AICO2 robot.
  
  Disables Shared Memory (SHM) transport entirely and uses UDP only.
  This prevents "Failed init_port" errors and resource contention when
  multiple nodes subscribe to high-bandwidth image topics (cameras).
  
  Set env var before launching:
    export FASTRTPS_DEFAULT_PROFILES_FILE=$(ros2 pkg prefix flexiv_amr_bringup)/share/flexiv_amr_bringup/config/fastrtps_profile.xml
  
  Or add to ~/.bashrc for permanent use.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="disable_shm" is_default_profile="true">
        <rtps>
            <useBuiltinTransports>false</useBuiltinTransports>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>
        </rtps>
    </participant>
</profiles>
