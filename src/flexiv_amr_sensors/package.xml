<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flexiv_amr_sensors</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="oelinux@todo.todo">oelinux</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Nodes launched by launch/sensors.launch.py -->
  <exec_depend>flexiv_amr_driver</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>realsense2_description</exec_depend>
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>ira_laser_tools</exec_depend>
  <!-- realsense.launch.py / visual_odometry.launch.py (unreferenced by other
       launch files in this repo, but restored 2026-09-18 because they may be
       invoked directly outside git-tracked launch files — see package README
       once confirmed on hardware). visual_odometry.launch.py uses the ROS 1
       rtabmap_ros package name, so it will not resolve on a ROS 2 rtabmap
       install unless that's aliased on this machine. -->
  <exec_depend>rtabmap_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
